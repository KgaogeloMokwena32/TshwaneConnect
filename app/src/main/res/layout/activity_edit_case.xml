<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050B63"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnBackEditCase"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:contentDescription="Go back"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Case"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TLF Case Management"
                    android:textColor="#DCE2FF"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- MAIN FORM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PAGE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Case Information"
                android:textColor="#050B63"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- PAGE DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Review and update the selected case information."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- CASE REFERENCE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Case Reference"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditCaseReference"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="e.g. TLF-001"
                android:inputType="textCapCharacters"
                android:maxLength="30"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#1F2937"
                android:textColorHint="#94A3B8" />

            <!-- TLF PROGRAMME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="TLF Programme"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEditCaseProgramme"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <!-- CASE SUMMARY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Case Summary"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditCaseSummary"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="Enter a brief description of the case..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:padding="14dp"
                android:textColor="#1F2937"
                android:textColorHint="#94A3B8" />

            <!-- CASE STATUS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Case Status"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEditCaseStatus"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:padding="12dp" />

            <!-- SAVE CHANGES BUTTON -->
            <Button
                android:id="@+id/btnSaveCaseChanges"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#050B63"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- CANCEL BUTTON -->
            <Button
                android:id="@+id/btnCancelEditCase"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E4E8F0"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
