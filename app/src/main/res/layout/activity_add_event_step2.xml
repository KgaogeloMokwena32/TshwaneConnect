<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/addEventHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#050B63"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBackToStep1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:contentDescription="Back to Step 1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Event"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tshwane Leadership Foundation"
                android:textColor="#E0E5FF"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:id="@+id/addEventScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/addEventHeader"
        app:layout_constraintBottom_toTopOf="@id/addEventFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PROGRESS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 2 OF 3"
                android:textColor="#050B63"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="#FFCC00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#E4E7EC" />
            </LinearLayout>

            <!-- HEADING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Location &amp; Image"
                android:textColor="#101828"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Where will your event take place? Add a photo to help staff recognise it."
                android:textColor="#667085"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- VENUE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Venue Name *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventVenue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:hint="e.g. TLF Community Centre"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- ADDRESS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Event Address *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventAddress"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:gravity="top|start"
                android:hint="Enter street address, suburb and city"
                android:inputType="textCapWords|textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- IMAGE SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Event Image (Optional)"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivEventPreview"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="#F0F2F7"
                    android:contentDescription="Selected event image preview"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvSelectedImageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="No image selected"
                    android:textColor="#667085"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnChooseEventImage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#050B63"
                    android:text="Choose Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="Choose an appropriate image for the event. Avoid sharing photos of beneficiaries without permission."
                android:textColor="#667085"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </ScrollView>

    <!-- FIXED FOOTER -->
    <LinearLayout
        android:id="@+id/addEventFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPreviousEventStep"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E4E7EC"
            android:text="Previous"
            android:textAllCaps="false"
            android:textColor="#050B63"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnNextEventStep2"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFCC00"
            android:text="Next →"
            android:textAllCaps="false"
            android:textColor="#050B63"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
