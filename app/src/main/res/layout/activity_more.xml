<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050B63"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnBackMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Go back"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="More"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TLF Connect • My Account"
                    android:textColor="#DCE2FF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- USER PROFILE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvMoreInitials"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="#050B63"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMoreStaffName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading profile..."
                        android:textColor="#050B63"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMoreStaffEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- NAVIGATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Navigation"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMoreProgrammes"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FFFFFF"
                android:text="Programmes"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMoreEvents"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Events"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMoreCurrent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E0E7FF"
                android:enabled="false"
                android:text="More • Current Page"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <!-- ACCOUNT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Account"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMoreProfile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FFFFFF"
                android:text="My Profile"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <!-- PREFERENCES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Preferences"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMoreSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FFFFFF"
                android:text="Settings"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMorePrivacy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Privacy &amp; Security"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <!-- SESSION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Session"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMoreLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FEE2E2"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="#B91C1C"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMoreBackDashboard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#050B63"
                android:text="Back to Dashboard"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="TLF Connect • Internal Staff Application"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
