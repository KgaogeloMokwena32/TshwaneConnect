<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050B63"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnBackEditEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Go back"
                android:padding="8dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Edit Event"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FORM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- EVENT TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter event title"
                android:inputType="textCapSentences"
                android:minHeight="52dp"
                android:padding="12dp"
                android:singleLine="true" />

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Description"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditEventDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="Describe the event"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp" />

            <!-- DATE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Event Date"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEditEventDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E4E8F0"
                android:text="Select Date"
                android:textAllCaps="false"
                android:textColor="#050B63" />

            <!-- START TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Start Time"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEditStartTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E4E8F0"
                android:text="Select Start Time"
                android:textAllCaps="false"
                android:textColor="#050B63" />

            <!-- END TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="End Time"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEditEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E4E8F0"
                android:text="Select End Time"
                android:textAllCaps="false"
                android:textColor="#050B63" />

            <!-- VENUE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Venue"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditEventVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter event venue"
                android:inputType="textCapWords"
                android:minHeight="52dp"
                android:padding="12dp" />

            <!-- ADDRESS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Address"
                android:textColor="#050B63"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEditEventAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter event address"
                android:inputType="textPostalAddress"
                android:minHeight="52dp"
                android:padding="12dp" />

            <!-- SAVE CHANGES -->
            <Button
                android:id="@+id/btnSaveEventChanges"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#050B63"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- CANCEL -->
            <Button
                android:id="@+id/btnCancelEditEvent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E4E8F0"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
