<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/addEventHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#050B63"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBackToEvents"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:contentDescription="Back to Events" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Event"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tshwane Leadership Foundation"
                android:textColor="#E0E5FF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- SCROLLABLE FORM -->
    <ScrollView
        android:id="@+id/addEventScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/addEventHeader"
        app:layout_constraintBottom_toTopOf="@id/addEventFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PROGRESS INDICATOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEP 1 OF 3"
                android:textColor="#050B63"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFCC00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="#E4E7EC" />

            </LinearLayout>

            <!-- FORM HEADING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Basic Information"
                android:textColor="#101828"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Start by entering the main details of your community event."
                android:textColor="#667085"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- EVENT TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Event Title *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:hint="Enter event title"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- EVENT DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Event Description *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventDescription"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:gravity="top|start"
                android:hint="Describe the purpose and activities of the event..."
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- EVENT DATE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Event Date *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select event date"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- START TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Start Time *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#050B63"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select start time"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- END TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="End Time *"
                android:textColor="#101828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#050B63"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select end time"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#101828"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

    <!-- FIXED FOOTER -->
    <LinearLayout
        android:id="@+id/addEventFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancelEvent"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E4E7EC"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#050B63"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnNextEventStep"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFCC00"
            android:text="Next →"
            android:textAllCaps="false"
            android:textColor="#050B63"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
