<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050B63"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnBackProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Go back"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TLF Connect • My Account"
                    android:textColor="#DCE2FF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PROFILE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- PROFILE AVATAR -->
                <TextView
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:background="#050B63"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:contentDescription="Profile avatar" />

                <!-- REAL USER NAME -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Loading profile..."
                    android:textColor="#050B63"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- REAL USER ROLE -->
                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <!-- REAL ACCOUNT STATUS -->
                <TextView
                    android:id="@+id/tvProfileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#E7F5EC"
                    android:padding="10dp"
                    android:text="Loading..."
                    android:textColor="#166534"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ACCOUNT INFORMATION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Account Information"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- ACCOUNT INFORMATION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- FULL NAME -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Loading..."
                    android:textColor="#050B63"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#E4E8F0" />

                <!-- EMAIL ADDRESS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Loading..."
                    android:textColor="#050B63"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#E4E8F0" />

                <!-- ORGANISATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Organisation"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tshwane Leadership Foundation"
                    android:textColor="#050B63"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#E4E8F0" />

                <!-- ACCOUNT TYPE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Type"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="See account role above"
                    android:textColor="#050B63"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PROFILE ACTIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Profile Actions"
                android:textColor="#050B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- SETTINGS -->
            <Button
                android:id="@+id/btnProfileSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#050B63"
                android:text="Open Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- PRIVACY -->
            <Button
                android:id="@+id/btnProfilePrivacy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E4E8F0"
                android:text="Privacy &amp; Security"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

            <!-- BACK TO MORE -->
            <Button
                android:id="@+id/btnProfileBackMore"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E4E8F0"
                android:text="Back to More"
                android:textAllCaps="false"
                android:textColor="#050B63"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
