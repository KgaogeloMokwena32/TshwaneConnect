<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#050B63"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBackCases"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:contentDescription="Go back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Case Management"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="TLF Connect • Staff Portal"
                android:textColor="#DCE2FF"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PAGE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cases Overview"
                android:textColor="#050B63"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="View, organise and manage case records across TLF programmes."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- SUMMARY CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:baselineAligned="false">

                <!-- TOTAL CASES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:elevation="2dp"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Cases"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalCases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0"
                        android:textColor="#050B63"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- ACTIVE CASES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:elevation="2dp"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Active Cases"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvActiveCases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0"
                        android:textColor="#15803D"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- SEARCH -->
            <EditText
                android:id="@+id/etSearchCases"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:hint="Search cases by reference, programme or summary..."
                android:inputType="text"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="#1F2937"
                android:textColorHint="#94A3B8" />

            <!-- STATUS FILTERS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAllCases"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="All"
                        android:textAllCaps="false"
                        android:backgroundTint="#050B63"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnActiveCases"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Active"
                        android:textAllCaps="false"
                        android:backgroundTint="#E4E8F0"
                        android:textColor="#050B63" />

                    <Button
                        android:id="@+id/btnPendingCases"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Pending"
                        android:textAllCaps="false"
                        android:backgroundTint="#E4E8F0"
                        android:textColor="#050B63" />

                    <Button
                        android:id="@+id/btnClosedCases"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Closed"
                        android:textAllCaps="false"
                        android:backgroundTint="#E4E8F0"
                        android:textColor="#050B63" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- CASE LIST TITLE -->
            <TextView
                android:id="@+id/tvCasesSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="All Cases"
                android:textColor="#050B63"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- CASE CARDS -->
            <LinearLayout
                android:id="@+id/casesListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/casesEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Cases Yet"
                    android:textColor="#050B63"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyCasesMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="No cases have been recorded yet."
                    android:textColor="#64748B"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ADD CASE BUTTON -->
            <Button
                android:id="@+id/btnAddCase"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#050B63"
                android:text="+ Add Case"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
